# Copia este archivo a .env y completa SOLO tu token. Nunca subas .env a GitHub.
# Crea el token en https://github.com/settings/personal-access-tokens/new
# Tipo: Fine-grained personal access token.
# Permisos mínimos: Contents: Read, solo sobre el repositorio gonor98/estacion-ia.
# Sin expiración larga: usa 90 días y renuévalo cuando caduque.
GITHUB_TOKEN=

# Opcionales (tienen valores por defecto razonables):
# MOLE_WORKSPACE_ROOT=~/workspace/goals
# MOLE_NOTES_FILE=~/workspace/mole-notes.md
